# ==========================================
# Citradhara - A Stream of Wonders
# 100% Free Video Platform Configuration
# ==========================================

# Firebase Web Configuration (Free Spark Plan)
# 1. Create a free project at https://console.firebase.google.com
# 2. Add a Web App & enable "Authentication -> Google Provider"
# 3. Enable "Cloud Firestore Database" in test mode or production rules
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Google Drive Direct Upload Webhook (Optional - 100% Free Google Apps Script)
# If you want community members to upload files directly into your personal Drive folder:
# Deploy the 10-line Google Apps Script in README.md as a Web App and paste URL here:
NEXT_PUBLIC_DRIVE_UPLOAD_WEBHOOK=https://script.google.com/macros/s/.../exec

# Target Google Drive Folder ID
NEXT_PUBLIC_DRIVE_FOLDER_ID=your-google-drive-folder-id
